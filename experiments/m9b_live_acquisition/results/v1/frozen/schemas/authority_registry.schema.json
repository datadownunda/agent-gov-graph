{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "source_id": {
      "type": "string",
      "minLength": 1
    },
    "source_version": {
      "type": "string",
      "minLength": 1
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "authority_record_id": {
            "type": "string",
            "minLength": 1
          },
          "authority_version": {
            "type": "string",
            "minLength": 1
          },
          "principal": {
            "type": "string",
            "minLength": 1
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "permitted_scopes": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "action": {
                  "type": "string",
                  "minLength": 1
                },
                "resource_type": {
                  "type": "string",
                  "minLength": 1
                },
                "resource_ids": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "required": [
                "action",
                "resource_type",
                "resource_ids"
              ],
              "additionalProperties": false
            }
          },
          "valid_from": {
            "type": "string",
            "format": "date-time"
          },
          "valid_to": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ]
          },
          "delegation_permitted": {
            "type": "boolean",
            "default": false,
            "description": "M5: all-or-nothing capability to delegate scopes in this complete authority state. Missing means false; no role inheritance."
          }
        },
        "required": [
          "authority_record_id",
          "authority_version",
          "principal",
          "roles",
          "permitted_scopes",
          "valid_from",
          "valid_to"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "source_id",
    "source_version",
    "records"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
