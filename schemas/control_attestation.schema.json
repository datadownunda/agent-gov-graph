{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "rule_version",
    "assertion_id",
    "control_reference",
    "reconciliation_reference",
    "verification_reference",
    "scope",
    "source_evidence_refs",
    "correlation_assertion_refs",
    "coverage_assessment",
    "evaluation_status",
    "finding",
    "basis_codes",
    "limitations"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "rule_version": {
      "const": "control-attestation/1"
    },
    "assertion_id": {
      "type": "string",
      "minLength": 1
    },
    "control_reference": {
      "type": "object",
      "required": [
        "content_digest"
      ]
    },
    "reconciliation_reference": {
      "type": [
        "string",
        "null"
      ]
    },
    "verification_reference": {
      "type": [
        "string",
        "null"
      ]
    },
    "scope": {
      "type": "object",
      "required": [
        "cardinality"
      ],
      "properties": {
        "cardinality": {
          "const": "SINGLE_ACTION"
        }
      }
    },
    "source_evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "correlation_assertion_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "coverage_assessment": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "result": {
          "enum": [
            "ADEQUATE",
            "INADEQUATE",
            "UNKNOWN"
          ]
        }
      }
    },
    "evaluation_status": {
      "enum": [
        "EVALUATED",
        "INSUFFICIENT_EVIDENCE",
        "NOT_EVALUABLE",
        "NOT_APPLICABLE"
      ]
    },
    "finding": {
      "enum": [
        "CONTROL_EFFECTIVE",
        "CONTROL_EFFECTIVENESS_EXCEPTION",
        "CONTROL_EFFECTIVENESS_NOT_DEMONSTRATED",
        null
      ]
    },
    "basis_codes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "evaluation_status": {
            "const": "EVALUATED"
          }
        }
      },
      "then": {
        "properties": {
          "finding": {
            "enum": [
              "CONTROL_EFFECTIVE",
              "CONTROL_EFFECTIVENESS_EXCEPTION"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "evaluation_status": {
            "const": "INSUFFICIENT_EVIDENCE"
          }
        }
      },
      "then": {
        "properties": {
          "finding": {
            "enum": [
              "CONTROL_EFFECTIVENESS_NOT_DEMONSTRATED"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "evaluation_status": {
            "const": "NOT_EVALUABLE"
          }
        }
      },
      "then": {
        "properties": {
          "finding": {
            "enum": [
              null
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "evaluation_status": {
            "const": "NOT_APPLICABLE"
          }
        }
      },
      "then": {
        "properties": {
          "finding": {
            "enum": [
              null
            ]
          }
        }
      }
    }
  ]
}
