{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/governance_decision_event.schema.json",
  "title": "Governance Decision Event",
  "type": "object",
  "required": [
    "event_id",
    "timestamp",
    "subject",
    "action",
    "resource",
    "policy",
    "decision"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "subject": {
      "type": "object",
      "required": ["id", "roles"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "roles": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "action": {
      "type": "string",
      "minLength": 1
    },
    "resource": {
      "type": "object",
      "required": ["id", "type", "classification"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "minLength": 1
        },
        "classification": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "policy": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "decision": {
      "type": "object",
      "required": ["allowed", "status", "reasons"],
      "properties": {
        "allowed": {
          "type": "boolean"
        },
        "status": {
          "type": "string",
          "enum": ["ALLOW", "DENY"]
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "telemetry": {
      "type": "object",
      "properties": {
        "trace_id": {
          "type": "string",
          "minLength": 1
        },
        "span_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "context": {
  "type": "object",
  "properties": {
    "workflow_id": {
      "type": "string",
      "minLength": 1
    },
    "agent_id": {
      "type": "string",
      "minLength": 1
    },
    "tool": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false
}
  },
  "additionalProperties": false
}