{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentgovgraph.dev/schemas/agent_governance_graph.schema.json",
  "title": "Agent Gov Graph",
  "description": "Portable graph representation of agent runtime governance evidence.",
  "type": "object",
  "required": [
    "graph_version",
    "nodes",
    "edges"
  ],
  "properties": {
    "graph_version": {
      "type": "string",
      "const": "1.0"
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/edge"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "node": {
      "type": "object",
      "required": [
        "id",
        "type",
        "properties"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "minLength": 1
        },
        "properties": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "edge": {
      "type": "object",
      "required": [
        "source",
        "relationship",
        "target",
        "properties"
      ],
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "relationship": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        "target": {
          "type": "string",
          "minLength": 1
        },
        "properties": {
          "type": "object"
        }
      },
      "additionalProperties": false
    }
  }
}