{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/execution_evidence_event.schema.json",
  "title": "Execution Evidence Event",
  "type": "object",
  "required": [
    "schema_version",
    "event_id",
    "timestamp",
    "action_attempt_id",
    "run_id",
    "step_id",
    "actor_id",
    "action",
    "resource",
    "effect",
    "source"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "action_attempt_id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "step_id": {
      "type": "string",
      "minLength": 1
    },
    "actor_id": {
      "type": "string",
      "minLength": 1
    },
    "action": {
      "type": "string",
      "minLength": 1
    },
    "resource": {
      "type": "object",
      "required": ["id", "type", "classification"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "minLength": 1
        },
        "classification": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "effect": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false
}
